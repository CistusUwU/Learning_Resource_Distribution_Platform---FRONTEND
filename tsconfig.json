{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@guard/*": ["./src/guard/*"],
      "@lib/*": ["./src/lib/*"],
      "@providers/*": ["./src/providers/*"],
      "@services/*": ["./src/services/*"],
      "@store/*": ["./src/store/*"],
      "@app-types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@app/*": ["./src/app/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/app/api/admin/transactions/.gitkeep", "src/app/api/payment/vnpay-ipn/.gitkeep", "src/app/api/payment/vnpay-return/.gitkeep", "src/app/api/staff/books/[id]/v/.gitkeep", "src/app/api/student/books/[id]/v/.gitkeep", "src/app/auth/callback/.gitkeep", "src/app/books/[id]/.gitkeep", "src/app/staff/admin/approvals/page.tsx", "src/app/staff/admin/revenue/payouts/[id]/.gitkeep", "src/app/staff/admin/revenue/.gitkeep", "src/app/staff/admin/staff/.gitkeep", "src/app/staff/admin/tags/.gitkeep", "src/app/staff/admin/transactions/[id]/.gitkeep", "src/app/staff/admin/transactions/.gitkeep"],
  "exclude": ["node_modules"]
}
